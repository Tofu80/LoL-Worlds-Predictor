{
  "env": {
    "SECURITY_GUIDANCE_COMMIT_REVIEW": "off",
    "ENABLE_STOP_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git checkout -b *)",
      "Bash(git commit -m *)",
      "Bash(pytest)",
      "Bash(pytest tests/*)",
      "Bash(ruff check *)",
      "Bash(ruff format *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --force-if-includes *)",
      "Bash(git push --mirror *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * *:main)",
      "Bash(git push * +main*)",
      "Bash(git push * *refs/heads/main*)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --amend *)",
      "Bash(git commit * --amend*)",
      "Bash(git commit -F *)",
      "Bash(git commit --file *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git add */data/raw/*)",
      "Bash(ruff * data/raw/*)",
      "Bash(pytest * --rootdir*)",
      "Bash(pytest * --confcutdir*)",
      "Edit(data/raw/**)"
    ]
  }
}
